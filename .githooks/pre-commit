#!/usr/bin/env bash
# Budget: about a second. Staged files only, no network.
. "$(git rev-parse --show-toplevel)/.githooks/lib.sh"

# tmp/ holds the pulled Musicolet APK and its decompiled, proprietary sources.
# .gitignore keeps them out; this catches a `git add -f`.
bad=$(staged '^tmp/|\.apk$|\.aab$|(^|/)\.env($|\.)|\.(pem|key|jks|keystore|p12)$|(^|/)\.claude/settings\.local\.json$')
[ -z "$bad" ] || die "staged files that must never be committed" $bad \
  "Unstage with: git restore --staged <file>"

for link in CLAUDE.md .claude/skills; do
  [ -L "$link" ] || die "$link is no longer a symlink" "Run: make init"
done

go=$(staged '\.go$')
if [ -n "$go" ]; then
  unformatted=$(run_on "$go" gofmt -l)
  [ -z "$unformatted" ] || die "staged Go is not gofmt-ed" $unformatted "Run: make fmt"
fi

swift=$(staged '\.swift$')
if [ -n "$swift" ]; then
  run_on "$swift" xcrun swift-format lint --strict >/dev/null 2>&1 \
    || die "staged Swift is not swift-format-ted" "Run: make fmt"
fi

docs=$(staged '\.(md|ya?ml|json|html|css|js)$' | while IFS= read -r f; do [ ! -L "$f" ] && echo "$f"; done || true)
if [ -n "$docs" ]; then
  run_on "$docs" npx --yes --prefer-offline prettier@latest --check >/dev/null 2>&1 \
    || die "staged Markdown/YAML/JSON or web client is not formatted" "Run: make fmt"
fi
