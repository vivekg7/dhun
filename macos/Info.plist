<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Dhun.app's Info.plist; scripts/build-mac.sh copies it into the bundle.
  The version here is the app's: raise it for every build that is installed.
-->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Dhun</string>
    <key>CFBundleDisplayName</key>
    <string>Dhun</string>
    <key>CFBundleIdentifier</key>
    <string>io.github.vivekg7.dhun</string>
    <key>CFBundleExecutable</key>
    <string>Dhun</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.12.0</string>
    <key>CFBundleVersion</key>
    <string>5</string>
    <key>CFBundleIconFile</key>
    <string>Dhun</string>
    <key>LSMinimumSystemVersion</key>
    <string>26.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.music</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- Plain HTTP to the NAS, at home and over Tailscale, which encrypts it (plans 003, 006). -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Dhun plays your music from the server on your home network.</string>
    <!-- Open With from Finder (plan 021): offered, never the default. -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Audio file</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.audio</string>
                <string>public.mp3</string>
                <string>public.mpeg-4-audio</string>
                <string>org.xiph.flac</string>
                <string>com.microsoft.waveform-audio</string>
                <string>public.aiff-audio</string>
                <string>org.xiph.ogg-audio</string>
                <string>org.xiph.opus</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>mp3</string>
                <string>m4a</string>
                <string>m4b</string>
                <string>aac</string>
                <string>flac</string>
                <string>opus</string>
                <string>ogg</string>
                <string>oga</string>
                <string>wav</string>
                <string>aif</string>
                <string>aiff</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
